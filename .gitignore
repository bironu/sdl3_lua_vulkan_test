# ビルド成果物(cmake -S . -B build)。実行ファイルと shaders/ は dist/ に出る
/build/
/dist/

# モーションの元データ(FBXなど)。ゲームが使うのは res/motion/ の変換済み(.vrma)で、FBXは tools の fbx2vrma で変換する
/motion_src/
# VMD(MMDのモーション)は管理しない。ゲームが使うのは変換済みの .vrma(確認用の VulkanSampleScene が、置いてあれば使う)
*.vmd

# macOS
.DS_Store

# エディタ・ツールの個人設定(共有する settings.json は追跡する)
.vscode/*
!.vscode/settings.json
.claude/settings.local.json
